# Core application
MONGO=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://cascadelogistics.co
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Partner API credential digest pepper. Generate a separate value with at
# least 32 random bytes. Never expose it to browsers or reuse an API key here.
# The complete partner platform is archived unless this is explicitly true.
PARTNER_PLATFORM_ENABLED=false
PARTNER_API_KEY_PEPPER=replace-with-at-least-32-random-characters

# Email transport. Use "gmail" for Gmail or Google Workspace, and "smtp"
# for a mailbox hosted by cPanel, Microsoft 365, Zoho, or another provider.
EMAIL_PROVIDER=gmail
EMAIL_USER=info@example.com
EMAIL_PASSWORD=replace-with-the-mailbox-password-or-app-password
EMAIL_FROM_NAME=Cascade Logistics
# Optional. Defaults to EMAIL_USER. The SMTP provider must permit this sender.
EMAIL_FROM_ADDRESS=info@example.com

# Required only when EMAIL_PROVIDER=smtp. Obtain these values from the
# professional mailbox provider. Typical combinations are port 465 with
# SMTP_SECURE=true, or port 587 with SMTP_SECURE=false.
# SMTP_HOST=mail.example.com
# EMAIL_HOST=mail.example.com # Backward-compatible alias for SMTP_HOST
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# Optional recipient for registration, shipment, and payment alerts.
# Falls back to EMAIL_FROM_ADDRESS, then EMAIL_USER, when omitted.
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Optional failover mailbox. When the primary provider cannot authenticate,
# connect, or is temporarily unavailable, the same email is retried once using
# this account. For a previous Gmail account, use its Gmail address and its
# 16-character Google app password. Keep these separate from EMAIL_USER and
# EMAIL_PASSWORD so both accounts are available at the same time.
# EMAIL_FALLBACK_PROVIDER=gmail
# EMAIL_FALLBACK_USER=previous-account@gmail.com
# EMAIL_FALLBACK_PASSWORD=replace-with-the-fallback-app-password
# EMAIL_FALLBACK_FROM_NAME=Cascade Logistics
# EMAIL_FALLBACK_FROM_ADDRESS=previous-account@gmail.com

# Required only when EMAIL_FALLBACK_PROVIDER=smtp:
# EMAIL_FALLBACK_SMTP_HOST=mail.example.com
# EMAIL_FALLBACK_HOST=mail.example.com # Alias for the host above
# EMAIL_FALLBACK_SMTP_PORT=587
# EMAIL_FALLBACK_SMTP_SECURE=false
# EMAIL_FALLBACK_SMTP_REQUIRE_TLS=true

# Vercel automatically provisions this for the project's connected Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional override when separate public and private stores are connected.
# Configure the private store with the PRIVATE environment-variable prefix.
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Required only for local client-upload callbacks through a tunnel such as ngrok.
VERCEL_BLOB_CALLBACK_URL=

# reCAPTCHA is currently disabled. Keep these commented for a future rollout.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Identity protection and retention
IDENTITY_HASH_SECRET=replace-with-a-separate-long-random-secret
IDENTITY_RETENTION_DAYS=90

# Vercel Cron authenticates retention cleanup with this secret
CRON_SECRET=replace-with-a-long-random-secret

# Encrypts partner webhook signing secrets at rest. Use a separate random value.
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Signs the separate partner developer-portal session cookie.
PARTNER_PORTAL_SESSION_SECRET=replace-with-another-long-random-secret

# One-time local administration scripts only; do not set in production runtime.
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-strong-temporary-password
