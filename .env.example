# Core application
MONGO=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Nodemailer / Gmail app password
EMAIL_USER=info@example.com
EMAIL_PASSWORD=replace-with-an-app-password
# Optional recipient for registration, shipment, and payment alerts.
# Falls back to EMAIL_USER when omitted.
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Vercel automatically provisions this for the project's connected Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional override when separate public and private stores are connected.
# Configure the private store with the PRIVATE environment-variable prefix.
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Required only for local client-upload callbacks through a tunnel such as ngrok.
VERCEL_BLOB_CALLBACK_URL=

# reCAPTCHA is currently disabled. Keep these commented for a future rollout.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Identity protection and retention
IDENTITY_HASH_SECRET=replace-with-a-separate-long-random-secret
IDENTITY_RETENTION_DAYS=90

# Vercel Cron authenticates retention cleanup with this secret
CRON_SECRET=replace-with-a-long-random-secret

# One-time local administration scripts only; do not set in production runtime.
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-strong-temporary-password
TEST_LOGIN_USERNAME=
TEST_LOGIN_PASSWORD=
DEBUG_USERNAME=
